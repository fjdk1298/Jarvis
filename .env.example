# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Alternative to ANTHROPIC_API_KEY (optional): https://openrouter.ai/keys
# If set, Jarvis will use OpenRouter instead of Anthropic directly.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Lower if your OpenRouter credits are tight.
LLM_MAX_TOKENS=220
# If true, Jarvis can run with a local Ollama model when cloud credits run out.
LOCAL_LLM_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct
# If true, only local model path is used (no cloud calls).
LOCAL_ONLY_MODE=true
# If true, try cloud first; if false, local Ollama is preferred first.
PREFER_CLOUD_LLM=false
# Set true to use Windows offline voice only (recommended for free/local setup).
FORCE_OFFLINE_TTS=true
# auto | edge | pyttsx3 | sapi | powershell
OFFLINE_TTS_ENGINE=edge
# Natural free voice for Edge TTS fallback.
EDGE_TTS_VOICE=en-GB-RyanNeural
# Enable animated desktop HUD window.
ENABLE_HUD=true
# In direct-listen mode (no Picovoice), optionally require "hey jarvis" prefix.
REQUIRE_WAKE_PREFIX=true
# Enable clap detection and hidden Windows startup launcher.
CLAP_DETECTION_ENABLED=true
# Recommended to avoid accidental launch from desk noise or mouse clicks.
CLAP_TRIGGER_COUNT=3
# If false, Jarvis starts silently in standby and speaks only after wake phrase.
STARTUP_GREETING_ON_BOOT=false

# Optional: get from https://elevenlabs.io/app/settings/api-keys
# Only needed when FORCE_OFFLINE_TTS=false
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Find "Charlie" voice ID by running: python -c "from elevenlabs import ElevenLabs; c = ElevenLabs(api_key='YOUR_KEY'); [print(v.voice_id, v.name) for v in c.voices.get_all().voices]"
# Only needed when FORCE_OFFLINE_TTS=false
ELEVENLABS_VOICE_ID=your_charlie_voice_id_here

# Optional: get from https://console.picovoice.ai (free account)
# If omitted, Jarvis runs in direct-listen mode without wake word.
PICOVOICE_ACCESS_KEY=your_picovoice_key_here
